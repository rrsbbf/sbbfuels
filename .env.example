# Copy this file to .env (or set these as real environment variables) to enable
# admin email alerts on top of the live dashboard alerts.
# The live dashboard (admin.html) works with NO configuration at all.

ADMIN_EMAIL=rishiraj@sbbfuels.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rishiraj@sbbfuels.com
SMTP_PASS=your-google-app-password
SMTP_FROM=rishiraj@sbbfuels.com
